# Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit the .env file to version control

# ================================
# Server Configuration
# ================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:8000

# ================================
# API Keys (REQUIRED)
# ================================

# Anthropic Claude API
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ElevenLabs Text-to-Speech
# Get your key at: https://elevenlabs.io/
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (for embeddings)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ================================
# Security
# ================================

# Session secret - Generate with: openssl rand -base64 32
SESSION_SECRET=change-this-to-random-string-generated-with-openssl

# JWT secret - Generate with: openssl rand -base64 32
JWT_SECRET=change-this-to-another-random-string

# ================================
# Database
# ================================

# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/aivoice

# Database pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ================================
# Redis (Session Store & Caching)
# ================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# File Upload
# ================================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv,json

# ================================
# Monitoring & Logging
# ================================

# Sentry DSN (optional)
SENTRY_DSN=

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ================================
# Email (Optional - for notifications)
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@yourdomain.com

# ================================
# Cloud Storage (Optional)
# ================================

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEYFILE_PATH=

# ================================
# External Integrations (Optional)
# ================================

# Google Drive API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Dropbox API
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# Notion API
NOTION_API_KEY=

# ================================
# Feature Flags
# ================================
ENABLE_ANALYTICS=true
ENABLE_VOICE_RECORDING=false
ENABLE_MFA=false

# ================================
# Performance
# ================================
CACHE_TTL=3600
REQUEST_TIMEOUT=30000
ENABLE_COMPRESSION=true
